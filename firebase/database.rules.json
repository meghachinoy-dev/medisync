{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "medicines": {
          "$medicineId": {
            ".validate": "newData.hasChildren(['name', 'dosage', 'compartmentNumber', 'scheduleDays', 'doseTimes'])",
            "compartmentNumber": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
            },
            "scheduleDays": {
              ".validate": "newData.isString() || newData.hasChildren()"
            }
          }
        },

        "dose_logs": {
          "$date": {
            "$logId": {
              ".validate": "newData.hasChildren(['medicineId', 'scheduledTime', 'status'])",
              "status": {
                ".validate": "newData.isString() && (newData.val() === 'taken' || newData.val() === 'missed' || newData.val() === 'pending' || newData.val() === 'upcoming')"
              }
            }
          }
        },

        "hardware_status": {
          ".validate": true
        },

        "compartments": {
          "$number": {
            "pillsRemaining": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'OK' || newData.val() === 'LOW' || newData.val() === 'EMPTY' || newData.val() === 'UNASSIGNED')"
            }
          }
        },

        "alerts": {
          "$alertId": {
            ".validate": "newData.hasChildren(['type', 'severity', 'message', 'createdAt'])",
            "severity": {
              ".validate": "newData.isString() && (newData.val() === 'critical' || newData.val() === 'warning' || newData.val() === 'info')"
            }
          }
        },

        "ai_rules": {
          "$ruleId": {
            ".validate": "newData.hasChildren(['patternType', 'confidence'])",
            "confidence": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            }
          }
        },

        "hardware_commands": {
          "schedule_update": {
            ".validate": "newData.isBoolean()"
          },
          "force_dispense": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "lcd_message": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          }
        },

        "schedule": {
          ".validate": true
        }
      }
    }
  }
}
